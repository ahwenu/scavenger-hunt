# 秘密値はブラウザに渡さず、サーバープロセスでだけ利用します。
# OPENAI_API_KEY または明示的な OPENAI_KEY_FILE のどちらかを設定。
OPENAI_KEY_FILE=/absolute/path/to/.env.local
# サービス間通信用トークンのファイル（値だけのテキスト）。
API_SERVICE_TOKEN_FILE=/absolute/path/to/api-service-token
PORT=4318
AGENTS_MODEL=gpt-6-luna
CHALLENGE_MODEL=gpt-6-luna
DECISIONS_MODEL=gpt-6-luna
# MVPでは外部画像サービスに依存しない。参考写真が必要なときだけtrue。
AI_REFERENCE_PHOTOS=false
