# 未指定はunconfigured。デモを明示的に有効にする場合だけdemoを指定。
KARIMONO_MODE=unconfigured
# Ahwenuの独立AI APIへの接続。OpenAIキー自体はAPI側だけで扱う。
KARIMONO_API_URL=http://127.0.0.1:4318
KARIMONO_API_TOKEN_FILE=
# 環境変数でトークンを渡す場合だけ指定。ファイル指定と併用しない。
KARIMONO_API_TOKEN=
# 以下は今後のゲームAPIアダプター用。現段階では使用しない。
SITES_API_BASE_URL=
HOST_SERVICE_TOKEN=
